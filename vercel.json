{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/script.js",
      "dest": "/script.js"
    },
    {
      "src": "/style.css",
      "dest": "/style.css"
    },
    {
      "src": "/med(.*)\\.gif",
      "dest": "/med$1.gif"
    },
    {
      "src": "/(.*)\\.mp3",
      "dest": "/$1.mp3"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
